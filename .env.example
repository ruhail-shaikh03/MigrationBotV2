# Database and Caching
DATABASE_URL=postgresql+asyncpg://migrationbot:migrationbot@localhost:5433/migrationbot
REDIS_URL=redis://localhost:6379

# API Keys & Auth secrets
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# REQUIRED — both backend/app/config.py and frontend/src/auth.ts refuse to boot without
# this (Phase 4). No default: a shared, publicly-known fallback would let any deployment
# that forgets to set it accept tokens forged against that known string. Generate a real
# random value, e.g. `openssl rand -hex 32` — do not reuse the placeholder below.
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
NEXTAUTH_SECRET=your-nextauth-secret-key
NEXTAUTH_URL=http://localhost:3000

# Off (unset/false) in every real deployment. Only set to true for local dev or the test
# suite — it lets any bearer token containing '@' authenticate as that identity with no
# signature check. See TDD.md §4.2.
ALLOW_DEV_AUTH=false

# Role assigned when a caller has no explicit `permissions` row (no project_id resolved,
# unknown user, or no row for that user+project). Defaults to "viewer" (fail-closed) if
# unset. Before flipping an existing deployment to this default, run
# `python -m scripts.seed_permissions` first or existing users lose write access — see
# that script's docstring and TDD.md §16.3.
# DEFAULT_ROLE=viewer

# REQUIRED — app/config.py has no default for this; the app will not boot without it
# (both the API and the queue worker die at import time with a RuntimeError).
# Comma-separated list of allowed origins, e.g. http://localhost:3000,https://migrationbot.duckdns.org
# Do NOT set this to "*": CORS is configured with allow_credentials=True, and Starlette does not
# treat a literal "*" as a wildcard for credentialed requests — it will boot, but cross-origin
# requests with credentials will fail.
CORS_ORIGINS=https://migrationbot.duckdns.org

# Default project sheet parameters
# DEFAULT_SPREADSHEET_ID is REQUIRED — no default in app/config.py.
DEFAULT_SPREADSHEET_ID=17mrUyJbhOhBbaQYzQ4iPFH6kPPHBjqOR3dt2EWGCDUA
DEFAULT_SHEET_TAB=SD
DEFAULT_SHEET_LABEL=FF Migration Tracker

# Admin access configuration (comma-separated emails)
# REQUIRED — no default in app/config.py.
ADMIN_EMAILS=ruhail.rizwan@tmcltd.com
