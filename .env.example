# Database and Caching
DATABASE_URL=postgresql+asyncpg://migrationbot:migrationbot@localhost:5433/migrationbot
REDIS_URL=redis://localhost:6379

# API Keys & Auth secrets
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
JWT_SECRET=your-jwt-secret-at-least-32-characters-long
NEXTAUTH_SECRET=your-nextauth-secret-key
NEXTAUTH_URL=http://localhost:3000

# REQUIRED — app/config.py has no default for this; the app will not boot without it
# (both the API and the queue worker die at import time with a RuntimeError).
# Comma-separated list of allowed origins, e.g. http://localhost:3000,https://migrationbot.duckdns.org
# Do NOT set this to "*": CORS is configured with allow_credentials=True, and Starlette does not
# treat a literal "*" as a wildcard for credentialed requests — it will boot, but cross-origin
# requests with credentials will fail.
CORS_ORIGINS=https://migrationbot.duckdns.org

# Default project sheet parameters
# DEFAULT_SPREADSHEET_ID is REQUIRED — no default in app/config.py.
DEFAULT_SPREADSHEET_ID=17mrUyJbhOhBbaQYzQ4iPFH6kPPHBjqOR3dt2EWGCDUA
DEFAULT_SHEET_TAB=SD
DEFAULT_SHEET_LABEL=FF Migration Tracker

# Admin access configuration (comma-separated emails)
# REQUIRED — no default in app/config.py.
ADMIN_EMAILS=ruhail.rizwan@tmcltd.com
